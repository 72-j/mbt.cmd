// examples:示例自证包（moon run examples——聚合定义 → 命令 → 事件 →
// SQLite 落库 → 重放重建 → 乐观并发拒写 → 快照等价，全链一跑自证）。
// 消费方视角的用法即文档：本包自带一份银行账户聚合定义（与主包测试
// 夹具互不共享——跨包 helper 不共享，各自本地定义）。
import {
  "moonbitlang/core/encoding/utf8",
  "thy1016/mooncmd",
}

pkgtype(kind: "executable")

// async main 依赖 async 库；SQLiteEventStore 走 native stub——本包 native
// only（moonspace examples 同款注记；库面主包仍 native+wasm）

supported_targets = "native"
