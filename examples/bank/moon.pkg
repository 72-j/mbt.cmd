// bank:银行业务账户聚合完整示例包(役7 转正定名)——词表 account_agg.toml
// + gen 产物 account_gen.mbt(黄金门逐字节,门住主包 account_agg_gate_test)
// + 策略钩子 account_policy.mbt(红线7 手写)+ main.mbt 十查链(EXAMPLE:PASS)。
// 役8 拆分随动:门面无再导出面(typealias 探针 [3002] 不支持)——消费方拨真籍
// (@aggregate/@command/@event/@store 直连)。
import {
  "moonbitlang/core/encoding/utf8",
  "thy1016/mooncmd",
  "thy1016/mooncmd/aggregate",
  "thy1016/mooncmd/command",
  "thy1016/mooncmd/event",
  "thy1016/mooncmd/store",
}

import {
  "moonbitlang/x/fs",
  "thy1016/skelschema",
  "thy1016/mooncmd/aggregate",
  "thy1016/mooncmd/command",
  "thy1016/mooncmd/event",
} for "test"

pkgtype(kind: "executable")

supported_targets = "native"
