// cmd 根包:moonx 入口(薄启动器)——argv 交 driver 主径(读表 → 发射 →
// 写盘三件 → 印 import 指引),本件只管进程出口(moonbitlang/x/sys
// 可移植 exit)。发射本体住 gen 包(纯 String→String 面,wasm-safe)。
import {
  "thy1016/cmd/gen",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/sys",
}

supported_targets = "native+wasm"

pkgtype(kind: "executable")
