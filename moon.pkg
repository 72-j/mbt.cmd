// mooncmd 主包门面——Router 住主目录 / EventSourcingErr 总族 / logger;
// 域类型无再导出面（typealias 本工具链不支持 [3002]），消费方按域直连
// @command/@event/@aggregate/@store。
import {
  "thy1016/mooncmd/command",
  "thy1016/mooncmd/event",
  "thy1016/mooncmd/aggregate",
  "thy1016/mooncmd/store",
  "thy1016/mooncmd/monads",
  "thy1016/mooncmd/projection",
}

import {
  "moonbitlang/x/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "thy1016/mooncmd/command",
  "thy1016/mooncmd/event",
  "thy1016/mooncmd/store",
  "thy1016/mooncmd/projection",
} for "test"

supported_targets = "wasm+native"

options(
  "is-main": false,
)
