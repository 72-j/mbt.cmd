// store:事件存储域(役8)——EventStore/SnapshotStore 记录面 + SQLiteEventStore
// supported_targets 随依赖支持域钉(sqlite3 = native+wasm;moonrdb/graph 同款)
supported_targets = "native+wasm"

import {
  "thy1016/mooncmd/event",
  "moonbit-community/sqlite3",
  "moonbitlang/async",
  "moonbitlang/core/json",
}

// 黑盒测试面:_test.mbt 伪包不继承主导入(被测包自动以 @store 在册);
// utf8 仅测试序列化夹具用,主面零依赖
import {
  "thy1016/mooncmd/event",
  "thy1016/mooncmd/aggregate",
  "thy1016/mooncmd/command",
  "moonbitlang/x/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/async",
} for "test"
