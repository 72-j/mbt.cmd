// ===== P2 符号响应 mock =====

///|
/// P2 mock: 复用纯模型预测符号响应（本骨架不产生新符号变量）
fn mock_command(
  model : Model,
  command : Command,
  gen_sym : @qcs.GenSym,
) -> (Response, @qcs.GenSym) {
  let (_, response) = model_execute(model, command)
  (response, gen_sym)
}

