fn bind_response(
  _symbolic : Response,
  _concrete : Response,
  env : @qcs.Environment[RefId],
) -> Result[@qcs.Environment[RefId], @qcs.BindError] {
  Ok(env) // TODO(P3 人工): 响应产生新变量时在此绑定
}

