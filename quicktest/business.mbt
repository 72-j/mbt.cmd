}

///|
/// P3 reify_command: 逐载荷解析 Symbolic → Concrete
fn reify_command(
  command : Command,
  _env : @qcs.Environment[RefId],
) -> Result[Command, @qcs.EnvError] {
  match command {
    Create => Ok(Create)
    Deposit => Ok(Deposit)
  }
}

///|
