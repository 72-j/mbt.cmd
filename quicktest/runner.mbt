// ===== 运行配置（源: [random_check]） =====

///|
fn quick_run_config() -> @qcs.RunConfig {
  {
    seed: 20261030UL,
    cases: 60,
    max_commands: 16,
    size: 16,
    max_tries: 20,
    shrink: true,
    max_shrinks: 60,
    max_shrink_rounds: 16,
    required_labels: [],
    required_command_names: ["Create", "Deposit"],
  }
}

// ===== 固定脚本（源: [[assert_check]], 5 步） =====

///|
fn assert_script() -> Array[Command] {
  [Create, Deposit, Deposit, Deposit, Create]
}

///|
/// 固定脚本检查: 失败即抛出（回归基准; 覆盖关键路径）
fn run_assert_check() -> @qcs.RunReport[Command, Response, Command, Response] raise {
  let script = assert_script()
  let config = { ..quick_run_config(), cases: 1, max_commands: 5, }
  @qcs.assert_check(quick_state_machine(script=Some(script)), config~)
}

///|
test "quick assert check passes" {
  let report = run_assert_check()
  // 第 5 步 Create 在 Active 态模型非法 → qcs valid 前置过滤跳过(不进引擎)
  assert_eq(report.commands_run, 4)
}

// ===== 覆盖率门（名单来自 [random_check].required_command_names）=====

///|
/// 名单是**业务面数据**（生成器不造默认值）；开启与否由"声明非空"决定。
/// 注意：qcs 覆盖判定是**逐用例**的 ⇒ 深状态机器请按"一条见证路径一个用例"在
/// 实例侧**运行时**派生名单（trig P4.3 ② / n3v2 `run_path_coverage_gate`）。
test "quick coverage gate: 长跑见证 Create/Deposit 与 resp:Continue" {
  let result = run_random_check(config=coverage_gate_config())
  match result {
    Ok(report) => assert_true(report.cases_run > 0)
    Err(_) => assert_true(false) // 覆盖门不应失败: 随机长跑踩不满两命令 = 生成面病
  }
}

///|
fn coverage_gate_config() -> @qcs.RunConfig {
  {
    ..quick_run_config(),
    cases: 1,
    max_commands: 200,
    required_labels: ["resp:Continue"],
    required_command_names: ["Create", "Deposit"],
  }
}

// ===== 随机属性测试 =====

///|
/// 随机检查: Result 返回, 失败信息含反例命令序列（供 CI 分支处理）
fn run_random_check(
  config~ : @qcs.RunConfig = quick_run_config(),
) -> Result[
  @qcs.RunReport[Command, Response, Command, Response],
  @qcs.RunFailure[Model, Model, Command, Command, Response, Response],
] {
  @qcs.check(quick_state_machine(), config~)
}

///|
test "quick random check passes" {
  let result = run_random_check()
  match result {
    Ok(report) => assert_eq(report.cases_run, 60)
    Err(_) => assert_true(false) // 随机检查不应失败: 模型与系统语义漂移
  }
}
