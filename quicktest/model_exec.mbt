// ========================================
// Model Exec - 纯模型执行器 — Generated by QuickMachine Code Generator
// FSM: mooncmd_account | Config: mooncmd_quick_machine
// Generated at: 1791000000000
// 默认实现"可运行但保守"；人工补充点以 TODO(P0)-TODO(P5) 标记
// ========================================
// model_execute 是规格（specification），不是被测实现：
// 臂结构与 [[transitions]] 一一对应；纯模型与真实执行器语义漂移由属性测试双执行比较兜底

///|
/// 纯模型执行: (Model, Command) -> (Model, Response)
/// 兜底 (_, _) => Error(1) 为非法转移
fn model_execute(model : Model, cmd : Command) -> (Model, Response) {
  match (model.state, cmd) {
    // --- Closed ---
    // @arm Closed+Create
    (Closed, Create) => ({ state: Active, }, Continue)
    // --- Active ---
    // @arm Active+Deposit
    (Active, Deposit) => (model, Continue)
    // 兜底: 非法转移（valid 已过滤, 防御性保留）
    (_, _) => (model, Error(1))
  }
}

///|
/// 模型推进（quickcheck_statemachine transition_symbolic/concrete 接口形态）
/// 非法/错误响应不推进模型
fn transition(model : Model, command : Command, response : Response) -> Model {
  match response {
    Error(_) => model
    _ => model_execute(model, command).0
  }
}

///|
test "mooncmd_quick_machine model_exec: 非法转移兜底 / transition 不推进" {
  // 非法转移兜底 + transition: 错误响应不推进
  let m = model_empty()
  let (m_bad, resp_bad) = model_execute(m, Deposit)
  assert_eq(resp_bad, Error(1))
  assert_eq(m_bad, m)
  let t_err = transition(m, Deposit, Error(1))
  assert_eq(t_err, m)
  // transition: 正常推进
  let t_ok = transition(m, Create, Continue)
  assert_true(t_ok != m)
}
